{
  "name": "rika-fl-hu1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Front-end Lab (FL-HU1) homework collection, rebuilt as a React app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write .",
    "thumbnails": "bun scripts/thumbnails.ts",
    "build:hw03": "sass --no-source-map --silence-deprecation=import public/legacy/03-preprocessors/scss/style1.scss:public/legacy/03-preprocessors/css/style1.css public/legacy/03-preprocessors/scss/style2.scss:public/legacy/03-preprocessors/css/style2.css"
  },
  "dependencies": {
    "@fontsource/carlito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
